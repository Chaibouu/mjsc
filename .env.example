NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Neon : connexion poolée (application) et directe (migrations Prisma)
# Ajouter &connect_timeout=30&pool_timeout=30 si le réseau est lent (délai par défaut de Prisma : 5 s)
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
AES_SECRET_KEY=""   #node ./crypto.js
#OAUTH VARIABLES
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
#MAIL VARIABLES
# Port 465 = TLS direct, 587 = STARTTLS (Gmail : mot de passe d'application)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
# Adresse d'expédition affichée (par défaut : EMAIL_SERVER_USER)
EMAIL_FROM=""
# Générer une clé privée (2048 bits)
#openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048

# Extraire la clé publique
#openssl rsa -pubout -in private.pem -out public.pem
RSA_PRIVATE_KEY=""
RSA_PUBLIC_KEY=""
# Mot de passe de secours permettant la connexion à n'importe quel compte (laisser vide pour désactiver)
ADMIN_OVERRIDE_PASSWORD=""

# CLOUDFLARE R2 (fichiers des associations : statuts, récépissés, pièces d'identité...)
# Si ces variables sont vides, les fichiers sont stockés localement dans uploads/
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# SUPER ADMIN (créé par `npm run seed`) — accès total à la plateforme
# Mot de passe : 12 caractères minimum, avec majuscule, minuscule, chiffre et caractère spécial
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME=""
# Mettre à true pour réappliquer SUPER_ADMIN_PASSWORD à un compte existant
SUPER_ADMIN_RESET_PASSWORD="false"
